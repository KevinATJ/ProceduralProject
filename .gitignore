# ===================================================
# Unity.gitignore
# Created by https://gitignore.io/api/unity
# Updated from https://github.com/github/gitignore/blob/main/Unity.gitignore
# ===================================================

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Cache and temporary files
.utmp/
*.tmp
*.bak

# Blender backups (not needed for version control)
*.blend1
*.blend1.meta

# Memory captures (can be huge and sensitive)
[Mm]emoryCaptures/

# Video or gameplay recordings
[Rr]ecordings/

# Asset Store tools (optional)
# /[Aa]ssets/AssetStoreTools*

# JetBrains Rider plugin and settings
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio / Consulo / MonoDevelop
.vs/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity meta files generated automatically
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash and debug files
sysinfo.txt
mono_crash.*

# Builds and packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
crashlytics-build.properties

# Test runner generated files
InitTestScene*.unity*

# Addressables (auto-generated content)
ServerData/
[Aa]ssets/StreamingAssets/aa*
[Aa]ssets/AddressableAssetsData/link.xml*
[Aa]ssets/Addressables_Temp*
[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting (Bolt) generated data
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated test scenes
[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Gradle cache (Android)
.gradle/

# ==============================================
# Recommended to KEEP under version control:
# ==============================================
# /Assets/
# /ProjectSettings/
# /Packages/
# /Assets/Scenes/
# /Assets/Scripts/
# ==============================================

